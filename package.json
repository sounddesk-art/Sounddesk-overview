{
  "name": "@sounddesk/public-overview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "validate:snapshot": "node scripts/validate-snapshot.mjs",
    "validate:readonly": "node scripts/validate-readonly-source.mjs",
    "build": "npm run validate:snapshot && npm run validate:readonly && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.0",
    "vite": "7.3.7",
    "typescript": "5.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0"
  }
}
